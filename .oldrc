alias drl='echo "Android Derlemesi Başlıyor" && haxelib run lime build android'
alias dr='echo "Debug Android Derlemesi Başlıyor" && haxelib run lime build android -debug'
alias ll='haxelib run lime build linux'
alias lw='echo "Windows Derlemsi Yapılıyor" && haxelib run lime build windows -mingw -D mingw -D no_shared_libs'
alias li='haxelib run lime build ios'
alias c='clear'
alias a='cd ~'
alias s='source ~/.bashrc'
alias so='source .oldrc'